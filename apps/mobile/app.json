{
  "expo": {
    "name": "Simmerplan",
    "slug": "simmerplan",
    "scheme": "simmerplan",
    "version": "1.0.0",
    "orientation": "portrait",
    "ios": {
      "bundleIdentifier": "com.simmerplan.app",
      "associatedDomains": [
        "applinks:simmerplan.com"
      ]
    },
    "android": {
      "package": "com.simmerplan.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "simmerplan.com",
              "pathPrefix": "/join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1093708328490-evl9sb2fotn9eu6ujovhafvun09g3pi6"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}

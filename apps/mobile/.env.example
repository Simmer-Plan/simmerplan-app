# Expo public env vars for the Simmerplan mobile app.
#
# These are EXPO_PUBLIC_* — embedded in the app bundle at build time, so they
# are NOT secret (client IDs are public). Copy this file to .env and fill in
# per environment. The Google OAuth client IDs come from the environment's
# Google Cloud project OAuth clients (see SIM-29); the "Web" client ID is also
# the idToken audience the backend verifies.

# Base URL of the environment's API Gateway (no trailing slash).
# tRPC appends /auth and /household.
EXPO_PUBLIC_API_URL=https://<api-id>.execute-api.ca-central-1.amazonaws.com

# Google "Web application" OAuth client ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<web-client-id>.apps.googleusercontent.com

# Google "iOS" OAuth client ID.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=<ios-client-id>.apps.googleusercontent.com
